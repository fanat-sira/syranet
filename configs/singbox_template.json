{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "::",
      "listen_port": "__HYSTERIA_PORT__",
      "users": "__HY2_USERS__",
      "tls": {
        "enabled": true,
        "alpn": ["h3"],
        "certificate_path": "/etc/sing-box/cert.pem",
        "key_path": "/etc/sing-box/key.pem"
      }
    },
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "::",
      "listen_port": "__SOCKS_PORT__",
      "users": "__SOCKS_USERS__"
    }
  ],
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-out",
      "server": "__NL_SERVER_ADDRESS__",
      "server_port": 443,
      "password": "__NL_PASSWORD__",
      "tls": {
        "enabled": true,
        "server_name": "__NL_SERVER_ADDRESS__",
        "insecure": true
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "outbound": "hy2-out"
      }
    ],
    "final": "direct"
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090"
    }
  }
}
