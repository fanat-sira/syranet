# Copy to .env and replace all empty required values before starting.
# Compose reads this file; the Go binary does not load .env automatically.
# Quote values containing $, # or spaces with single quotes.

# Required: PostgreSQL (host/port below are forced by Compose for the app).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vpn_service
DB_USER=vpn_admin
DB_PASSWORD=

# Required: two distinct Telegram bots and comma-separated numeric admin IDs.
USER_BOT_TOKEN=
ADMIN_BOT_TOKEN=
ADMIN_IDS=

# Required: RU public hostname/IP and existing NL Hysteria2 upstream credentials.
RU_SERVER_ADDRESS=
NL_SERVER_ADDRESS=
NL_PASSWORD=

# Optional: old credentials, only during migration. SOCKS values must be paired.
FALLBACK_HY2_PASSWORD=
FALLBACK_SOCKS_USERNAME=
FALLBACK_SOCKS_PASSWORD=

# App and database tuning.
APP_ENV=production
LOG_LEVEL=info
APP_SHUTDOWN_TIMEOUT=15s
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MIN_OPEN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
BOT_POLLING_TIMEOUT=30

# VPN policy and public ports; match host firewall/client configuration.
HYSTERIA_PORT=443
SOCKS_PORT=8443
SUBSCRIPTION_DAYS=30
HYSTERIA_LINK_NAME='Syranet VPN'
# Currently unused by the Telegram SOCKS link generator.
SOCKS_LINK_NAME='Syranet VPN SOCKS'
CONCURRENT_CONNECTION_LIMIT=1
REMINDER_THRESHOLD=72h

# Container paths. Changing mount locations also requires editing Compose.
SINGBOX_CONFIG_PATH=/etc/sing-box/config.json
SINGBOX_TEMPLATE_PATH=/app/configs/singbox_template.json
SINGBOX_BINARY_PATH=/usr/bin/sing-box
SINGBOX_CONFIG_DIR=/etc/sing-box
SINGBOX_USE_SYSTEMD=true
SINGBOX_SERVICE_NAME=sing-box
SINGBOX_CHECK_TIMEOUT=10s
# Only used with SINGBOX_USE_SYSTEMD=false; requires access to the target process.
SINGBOX_PID_FILE=
SINGBOX_RELOAD_SIGNAL=HUP

# Host API must be reachable from the Docker bridge; see README.
MONITORING_ENABLED=true
CLASH_API_URL=http://host.docker.internal:9090
CLASH_API_POLL_INTERVAL=30s
# Counts API connections, not devices. Automatic disconnect is opt-in.
DISCONNECT_EXTRA_SESSIONS=false
ADMIN_NOTIFICATION_ENABLED=true
