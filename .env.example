# scripts/setup.py creates private .env and deployment config interactively.
# Never use production secrets in tests. The binary reads the environment, not .env.
COMPOSE_PROJECT_NAME=syranet
# management YAML on the host (mounts as /app/config.yaml)
PLATFORM_CONFIG=./configs/local.yaml
# generated secret values; replace blanks or use setup.py
DB_NAME=syranet
DB_USER=syranet
DB_PASSWORD=
USER_BOT_TOKEN=
ADMIN_BOT_TOKEN=
# positive numeric Telegram IDs, separated by commas
ADMIN_IDS=
ENTRY_AGENT_TOKEN=
# enabled only when adding an upstream node
UPSTREAM_AGENT_TOKEN=
UPSTREAM_TRANSIT_PASSWORD=
# existing PEM files, copied by scripts/certificates.sh
CERTS_DIR=./certs
# Management needs only public CA material, never the node private key.
TRUST_DIR=./trust
# public Hysteria2 UDP port; match node.port in YAML
HYSTERIA_PORT=443
# Optional direct-binary DB settings (Compose fixes internal host/port).
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable
BOT_POLLING_TIMEOUT=30
# Go binary direct launch only; Compose uses /app/config.yaml.
CONFIG_PATH=configs/local.yaml
