# Copy to private .node.env on the remote VPS; populate with generated values.
COMPOSE_PROJECT_NAME=syranet-upstream
NODE_DOMAIN=upstream.example.net
NODE_TOKEN=
HYSTERIA_PORT=443
# Bind management to a private interface reachable from the management VPS.
MANAGEMENT_BIND_IP=127.0.0.1
# Paths are relative to deploy/node.compose.yml's directory.
CERTS_DIR=../certs
# The Compose file sets these for HTTPS; listed here for direct-binary reference.
# NODE_LISTEN=:8443
# NODE_API_TLS_CERT=/certs/fullchain.pem
# NODE_API_TLS_KEY=/certs/privkey.pem
# NODE_STATE=/state
# SINGBOX_BINARY=/usr/local/bin/sing-box
# NODE_HEALTH_URL=https://upstream.example.net:8443
# NODE_HEALTH_CA=/certs/ca.pem
